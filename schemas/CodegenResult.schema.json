{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "CodegenResult",
  "title": "CodegenResult",
  "description": "S5 の最終結果（Reflexion 系列をプロバナンス化）。types.ts:CodegenResult に一致。",
  "type": "object",
  "additionalProperties": false,
  "required": ["strategy_id", "passed", "attempts", "feedbackHistory"],
  "properties": {
    "strategy_id": { "type": "string" },
    "passed": { "type": "boolean" },
    "attempts": { "type": "number" },
    "feedbackHistory": { "type": "array", "items": { "type": "string" } },
    "finalFeedback": { "type": "string" }
  }
}
