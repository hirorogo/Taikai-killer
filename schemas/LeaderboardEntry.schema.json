{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "LeaderboardEntry",
  "title": "LeaderboardEntry",
  "description": "outputs/leaderboard.json の1要素。run 横断の最強選抜。types.ts:LeaderboardEntry に一致。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "strategy_id",
    "rubric_ref",
    "score",
    "passed_test_ratio",
    "result_ref",
    "ts"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "strategy_id": { "type": "string" },
    "rubric_ref": { "type": "string" },
    "score": { "type": "number" },
    "passed_test_ratio": { "type": "number" },
    "result_ref": { "type": "string" },
    "ts": { "type": "string" }
  }
}
