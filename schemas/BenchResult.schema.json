{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "BenchResult",
  "title": "BenchResult",
  "description": "S6 ベンチマーク結果（result.json）。types.ts:BenchResult に一致。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "strategy_id",
    "rubric_ref",
    "eval_mode",
    "score",
    "rank",
    "metrics",
    "threshold"
  ],
  "properties": {
    "result_id": { "type": "string" },
    "strategy_id": { "type": "string" },
    "rubric_ref": { "type": "string" },
    "eval_mode": { "type": "string", "enum": ["test", "battle"] },
    "score": { "type": "number" },
    "rank": { "type": "number" },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "passed_test_ratio": { "type": "number" },
    "win_rate": { "type": "number" },
    "battle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opponents", "record", "format"],
      "properties": {
        "opponents": { "type": "array", "items": { "type": "string" } },
        "record": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wins", "losses", "draws"],
          "properties": {
            "wins": { "type": "number" },
            "losses": { "type": "number" },
            "draws": { "type": "number" }
          }
        },
        "format": { "type": "string", "enum": ["round_robin", "tournament"] }
      }
    },
    "distance": { "type": "number" },
    "diff_vs_prev": { "type": "number" },
    "provenance": { "$ref": "Provenance" },
    "threshold": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "number" }
        }
      }
    }
  }
}
